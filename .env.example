# =============================================================================
# Project Sentinel — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinel
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://sentinel:sentinel_secret@localhost:5432/sentinel?sslmode=disable

# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=sentinel_secret
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://sentinel:sentinel_secret@localhost:5672/

# ---------- Redis ----------
REDIS_HOST=localhost
# NOTE: docker-compose publishes Redis on host port 6380 to avoid clashing with
# a locally installed Redis. Native dev (make dev-api) must therefore use 6380,
# not 6379 — the old value here silently failed to connect.
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6380/0

# ---------- API Server ----------
API_PORT=8080
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=30s
API_RATE_LIMIT=100
GIN_MODE=release
# Comma-separated CORS / WebSocket origin allowlist. "*" is dev-only.
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated CIDRs allowed to set X-Forwarded-For. Empty = trust nobody.
API_TRUSTED_PROXIES=
# How often to sweep for jobs stranded by a crash. 0 disables (not recommended).
API_REAP_INTERVAL=30s

# ---------- Worker ----------
# Pool size doubles as the AMQP prefetch count: because ack happens after
# execution, prefetch is the real concurrency ceiling per worker process.
WORKER_POOL_SIZE=4
WORKER_NSJAIL_PATH=/usr/bin/nsjail
# Absolute path. In the container the configs live at /etc/sentinel/nsjail;
# a relative path resolves against CWD (/) and silently does not exist.
WORKER_SANDBOX_CONFIG_DIR=/etc/sentinel/nsjail
# Time allowed for in-flight jobs to finish on SIGTERM. Keep below the
# orchestrator grace period (60s).
WORKER_DRAIN_TIMEOUT=45s
WORKER_METRICS_PORT=9090

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080

# ---------- Observability ----------
PROMETHEUS_ENABLED=true
LOG_LEVEL=debug
LOG_FORMAT=json
